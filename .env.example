# Environment variables for Easyland's AI Social Media Sales Dashboard.
#
# IMPORTANT: This project currently runs entirely on mock/demo data and does
# NOT read any environment variables at runtime (there is no `process.env`
# usage in `src/`). Nothing below is required to run `npm run dev` today.
#
# These are placeholders for the REAL integrations the app is architected
# for (see `src/lib/integrations/*`) but does not yet call. Fill them in
# only once you wire up the corresponding real service — never commit real
# values, copy this file to `.env.local` and fill it in there instead:
#
#   cp .env.example .env.local

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# --- WhatsApp Business Cloud API (see src/lib/integrations/whatsapp) -------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- AI / chatbot + call agent (currently rule-based, no LLM connected) ----
OPENAI_API_KEY=

# --- Google Calendar (see src/lib/integrations/calendar) -------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- Google Sheets (see src/lib/integrations/sheets) ------------------------
GOOGLE_SHEET_ID=

# --- AI Call Agent telephony (see src/lib/integrations/calling) ------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
