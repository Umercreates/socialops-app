# Environment variables for EasyLife's AI Social Media Sales Dashboard.
#
# Most of this app still runs on realistic mock/demo data — DEMO_MODE
# governs that behavior. GEMINI_API_KEY is the one integration wired to a
# real provider (see src/app/api/ai/assistant + src/lib/services/gemini-client.ts);
# it falls back to a local template automatically if the call fails for any
# reason, so the app never breaks in a demo. Every other integration below
# is a documented seam (see src/lib/integrations/*) that isn't called yet.
#
# Never commit real values — copy this file to `.env.local` and fill it in
# there instead:
#
#   cp .env.example .env.local

DEMO_MODE=
CRM_MODE=
AUTH_MODE=

APP_URL=
AUTH_SECRET=

# --- PostgreSQL (see src/lib/db/client.ts) — Phase 2 persistence -----------
DATABASE_URL=
DATABASE_SSL=

# --- First-owner bootstrap (see src/app/api/setup) --------------------------
# Required to POST /api/setup. Remove from the production environment once
# the first owner account has been created - this app's first owner already
# exists in production, so SETUP_TOKEN should stay retired (unset) there.
SETUP_TOKEN=

# --- Production migrations (see src/app/api/admin/migrate) -----------------
# Gates the versioned-migration runner - this host has no SSH access, so
# this HTTPS endpoint is the only way to apply migrations/*.sql. Dedicated
# token, never SETUP_TOKEN: unlike setup, migrations are an ongoing need
# (new ones ship over time), so this stays configured indefinitely rather
# than being retired after first use.
MIGRATION_TOKEN=

# --- Production cache maintenance (see app.js /__cache-purge) --------------
# Gates a maintenance-only endpoint that purges exactly one hardcoded
# LiteSpeed-cached URL (/dashboard). Dedicated token, not reused from
# SETUP_TOKEN/AUTH_SECRET, so it can outlive the setup-token lifecycle.
CACHE_PURGE_TOKEN=

# --- Gemini LLM (see src/lib/services/gemini-client.ts) --------------------
# Server default, used when no workspace-specific encrypted credential is
# saved in APIs & Integrations (see INTEGRATIONS_ENCRYPTION_KEY below).
GEMINI_API_KEY=

# --- OmniDimension AI Calling (see src/lib/integrations/calling) -----------
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=
OMNIDIM_FROM_NUMBER_ID=

# --- Phase 3: APIs & Integrations Control Center ----------------------------
# AES-256-GCM key encrypting workspace-specific provider credentials at rest
# (see src/lib/integrations/crypto.ts). Generate with e.g. `openssl rand -hex 32`.
# Server-only — never NEXT_PUBLIC_, never committed, never logged.
INTEGRATIONS_ENCRYPTION_KEY=

# --- Meta / WhatsApp Cloud API ----------------------------------------------
# These are no longer read directly — WhatsApp/Meta credentials are stored
# per-workspace, encrypted, via APIs & Integrations (/dashboard/integrations)
# instead of global env vars. Left here only as documentation of the
# concepts; not wired to any code path.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Google platform OAuth app (see src/lib/integrations/providers.ts) -----
# Only needed if EasyLife operates its own Google OAuth app so clients can
# just click "Connect Google" instead of registering their own developer
# app (youtube, google-sheets, google-calendar all share one app). Without
# these, each workspace supplies its own Client ID/secret instead - a
# fully working fallback, just not the one-click experience.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are accepted as aliases for
# backward compatibility with an environment configured before the
# *_PLATFORM_* names existed - GOOGLE_PLATFORM_* is canonical going forward.
GOOGLE_PLATFORM_CLIENT_ID=
GOOGLE_PLATFORM_CLIENT_SECRET=

# --- Google Sheets default spreadsheet (optional) ---------------------------
# NOT required per-workspace - each workspace selects its own spreadsheet
# after connecting Google (stored in Postgres, see workspace_google_sheets_selection
# in migrations/). This is only an optional platform-wide fallback for a
# workspace that hasn't made its own selection yet.
GOOGLE_SHEET_ID=
